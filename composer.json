{
    "name": "kode/console",
    "description": "健壮、通用的 PHP 控制台组件，要求 PHP 8.3+，内置签名 DSL、注解式命令、中间件与事件系统",
    "keywords": ["console", "cli", "command", "terminal", "php83", "php84", "php85", "framework", "kodephp"],
    "homepage": "https://github.com/kodephp/console",
    "license": "Apache-2.0",
    "version": "4.0.0",
    "authors": [
        {
            "name": "KodePHP Team",
            "email": "382601296@qq.com"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "ext-mbstring": "更精确地计算全角字符宽度，使表格对齐更稳定"
    },
    "autoload": {
        "psr-4": {
            "Kode\\Console\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kode\\Console\\Tests\\": "tests/",
            "Kode\\Console\\Examples\\": "examples/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.0-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
