{
    "name": "kode/console",
    "description": "健壮、通用的 PHP 控制台组件，支持 PHP 8.1+ 新特性",
    "keywords": ["console", "cli", "command", "php81", "php82", "php83", "php84", "php85", "framework", "kodephp"],
    "homepage": "https://github.com/kodephp/console",
    "license": "Apache-2.0",
    "version": "3.0.0",
    "authors": [
        {
            "name": "KodePHP Team",
            "email": "382601296@qq.com"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Kode\\Console\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kode\\Console\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src --level=9"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
